// ============================================================================
// 2. NATIVE C99 ODBC ABI BINDINGS & POINTER HELPERS
// ============================================================================

pub fn null_ptr() voidptr {
	return 0
}

fn zero_short() c_short {
	return 0
}

@[intrinsic: 'vira_str_from_cstr']
fn cstr_to_string(ptr voidptr) string

extern "C" {
	// C standard heap helpers for scratch buffers
	fn calloc(nmemb c_size, size c_size) voidptr
	fn free(ptr voidptr)

	// Handle Lifecycle
	fn SQLAllocHandle(handle_type c_short, input_handle voidptr, output_handle &mut voidptr) c_short
	fn SQLFreeHandle(handle_type c_short, handle voidptr) c_short

	// Environment & Connection Configuration
	fn SQLSetEnvAttr(env_handle voidptr, attribute c_int, value c_long, str_len c_int) c_short
	fn SQLSetConnectAttr(conn_handle voidptr, attribute c_int, value c_long, str_len c_int) c_short

	// Connection Establishment & Teardown
	fn SQLDriverConnect(
		hdbc voidptr,
		hwnd voidptr,
		conn_str_in &c_char,
		cb_in c_short,
		conn_str_out voidptr,
		cb_out_max c_short,
		pcb_out &mut c_short,
		driver_completion c_ushort
	) c_short

	fn SQLConnect(
		hdbc voidptr,
		server_name &c_char,
		name_len1 c_short,
		user_name &c_char,
		name_len2 c_short,
		auth &c_char,
		name_len3 c_short
	) c_short

	fn SQLDisconnect(hdbc voidptr) c_short

	// Statement Preparation & Execution
	fn SQLExecDirect(hstmt voidptr, sql_text &c_char, text_len c_int) c_short
	fn SQLPrepare(hstmt voidptr, sql_text &c_char, text_len c_int) c_short
	fn SQLExecute(hstmt voidptr) c_short
	fn SQLCloseCursor(hstmt voidptr) c_short

	// Parameter Binding
	fn SQLBindParameter(
		hstmt voidptr,
		param_num c_ushort,
		io_type c_short,
		value_type c_short,
		param_type c_short,
		col_size c_ulong,
		dec_digits c_short,
		param_val_ptr voidptr,
		buf_len c_long,
		str_len_or_ind &mut i64
	) c_short

	// Result Set Metadata & Row Fetching
	fn SQLNumResultCols(hstmt voidptr, col_count &mut c_short) c_short
	fn SQLRowCount(hstmt voidptr, row_count &mut i64) c_short
	fn SQLDescribeCol(
		hstmt voidptr,
		col_num c_ushort,
		col_name voidptr,
		buf_len c_short,
		name_len &mut c_short,
		data_type &mut c_short,
		col_size &mut i64,
		dec_digits &mut c_short,
		nullable &mut c_short
	) c_short
	fn SQLFetch(hstmt voidptr) c_short
	fn SQLGetData(
		hstmt voidptr,
		col_num c_ushort,
		target_type c_short,
		target_val voidptr,
		buf_len c_long,
		str_len_or_ind &mut i64
	) c_short

	// Transaction Control
	fn SQLEndTran(handle_type c_short, handle voidptr, completion_type c_short) c_short

	// Diagnostics & Driver / DSN Discovery
	fn SQLGetDiagRec(
		handle_type c_short,
		handle voidptr,
		rec_num c_short,
		sqlstate voidptr,
		native_err &mut int,
		msg_text voidptr,
		buf_len c_short,
		text_len &mut c_short
	) c_short

	fn SQLDrivers(
		henv voidptr,
		direction c_ushort,
		driver_desc voidptr,
		desc_max c_short,
		pcb_desc &mut c_short,
		driver_attr voidptr,
		attr_max c_short,
		pcb_attr &mut c_short
	) c_short

	fn SQLDataSources(
		henv voidptr,
		direction c_ushort,
		server_name voidptr,
		buf_len1 c_short,
		name_len1 &mut c_short,
		description voidptr,
		buf_len2 c_short,
		name_len2 &mut c_short
	) c_short
}

// is_succeeded returns true if the ODBC return code is SQL_SUCCESS or SQL_SUCCESS_WITH_INFO.
pub fn is_succeeded(rc int) bool {
	return rc == SQL_SUCCESS || rc == SQL_SUCCESS_WITH_INFO
}

// extract_diag_error queries SQLGetDiagRec on an ENV, DBC, or STMT handle and returns
// a formatted diagnostic message with SQLSTATE and NativeError code.
pub fn extract_diag_error(handle_type int, handle voidptr) string {
	unsafe {
		state_buf := calloc(8, 1)
		msg_buf := calloc(1024, 1)
		mut native_err := 0
		mut text_len := zero_short()

		rc := SQLGetDiagRec(
			handle_type,
			handle,
			1,
			state_buf,
			&mut native_err,
			msg_buf,
			1023,
			&mut text_len
		)

		mut result := "ODBC error (no diagnostic record available)"
		if int(rc) == SQL_SUCCESS || int(rc) == SQL_SUCCESS_WITH_INFO {
			sql_state := cstr_to_string(state_buf)
			msg_str := cstr_to_string(msg_buf)
			result = "[SQLSTATE ${sql_state}] (Code ${native_err}) ${msg_str}"
		}

		free(state_buf)
		free(msg_buf)
		return result
	}
}
